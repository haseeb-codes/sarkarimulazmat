# Pooled connection for the app (Supabase transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode / direct connection for migrations (prisma.config.ts)
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Cloudflare Turnstile (free captcha) — https://dash.cloudflare.com/?to=/:account/turnstile
# Local always-pass test keys (replace with your real keys in production):
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
