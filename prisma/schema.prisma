generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Job Postings model matching the zero-inference extraction schema
model JobPosting {
  id                       String          @id @default(uuid())
  slug                     String          @unique
  active                   Boolean         @default(true)
  title                    String
  description              String?
  department               String
  projectProgramName       String?         @map("project_program_name")
  postedBy                 String?         @map("posted_by")
  employmentType           EmploymentType? @map("employment_type")
  grade                    String?
  equivalentGrade          Int?            @map("equivalent_grade")
  qualificationLevel       Int             @map("qualification_level")
  degrees                  String[]        @default([])
  degreeArea               String[]        @default([]) @map("degree_area")
  educationLevel           String          @map("education_level")
  educationYears           Int?            @map("education_years")
  certifications           String[]        @default([])
  donorName                String?         @map("donor_name")
  vacancies                Int?
  placeOfPosting           String[]        @default([]) @map("place_of_posting")
  domicile                 String?
  experience               String?
  preferredExperience      String?         @map("preferred_experience")
  minAge                   Int?            @map("min_age")
  maxAge                   Int?            @map("max_age")
  ageRelaxation            String?         @map("age_relaxation")
  gender                   String[]        @default([])
  isQuotaBasis             Boolean         @default(false) @map("is_quota_basis")
  maleQuota                String?         @map("male_quota")
  maleHeadcount            Int?            @map("male_headcount")
  femaleQuota              Boolean         @default(false) @map("female_quota")
  femaleHeadcount          Int?            @map("female_headcount")
  disabilityQuota          Boolean         @default(false) @map("disability_quota")
  minorityQuota            Boolean         @default(false) @map("minority_quota")
  nocRequired              Boolean         @default(false) @map("noc_required")
  applicationFee           String?         @map("application_fee")
  salary                   String?
  lastDateToApply          String?         @map("last_date_to_apply")
  daysToApply              Int?            @map("days_to_apply")
  applicationPostalAddress String?         @map("application_postal_address")
  applicationOnlineAddress String?         @map("application_online_address")
  newsSource               String?         @map("news_source")
  adCode                   String?         @map("ad_code")
  adDate                   String?         @map("ad_date")
  url                      String?
  email                    String?
  phone                    String?
  rawText                  String          @map("raw_text")
  notes                    String?
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  @@index([active])
  @@index([department])
  @@index([postedBy])
  @@index([qualificationLevel])
  @@index([equivalentGrade])
  @@map("job_postings")
}

