/// Curated SEO landing pages with preset filters (e.g. /engineering-jobs, /bs-cs)
model CategoryPage {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  h1               String
  meta_description String
  intro_content    String
  filters          Json
  is_indexed       Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@map("category_pages")
}

/// Anonymous visitor identity (cookie-linked)
model Visitor {
  id          String        @id @default(uuid())
  first_seen  DateTime      @default(now()) @map("first_seen_at")
  last_seen   DateTime      @default(now()) @map("last_seen_at")
  visit_count Int           @default(1)
  user_id     String?       @map("user_id")
  saved       SavedSearch[]
  search_logs SearchLog[]

  @@map("visitors")
}

/// Filter usage log for aggregate analysis
model SearchLog {
  id           String   @id @default(cuid())
  visitor_id   String?  @map("visitor_id")
  user_id      String?  @map("user_id")
  filters      Json
  result_count Int      @map("result_count")
  created_at   DateTime @default(now()) @map("created_at")
  visitor      Visitor? @relation(fields: [visitor_id], references: [id])

  @@index([created_at])
  @@index([visitor_id])
  @@map("search_logs")
}

/// Saved filter sets for anonymous visitors and signed-in users
model SavedSearch {
  id               String   @id @default(cuid())
  visitor_id       String?  @map("visitor_id")
  user_id          String?  @map("user_id")
  label            String?
  filters          Json
  email_subscribed Boolean  @default(false) @map("email_subscribed")
  created_at       DateTime @default(now()) @map("created_at")
  visitor          Visitor? @relation(fields: [visitor_id], references: [id])

  @@index([visitor_id])
  @@index([user_id])
  @@map("saved_searches")
}

/// Enum for standardized employment terms
enum EmploymentType {
  Permanent
  Contract
}
